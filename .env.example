# ---------------------------------------------------------------------------
# opencode-free-api -- every value below is optional; the defaults mirror what a
# stock `opencode` install uses. Do NOT commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Listen address.
# HOST=127.0.0.1
# PORT=8787

# Real OpenCode credential (a Console service-account key). Leave UNSET to run on
# OpenCode Zen's anonymous free tier. When set, paid models become callable too
# and all usage is billed to that account.
# OPENCODE_API_KEY=

# Model catalog root; "/api.json" is appended.
# Same default and same variable name as OpenCode itself (packages/core/src/models-dev.ts:160).
# OPENCODE_MODELS_URL=https://models.opencode.ai

# Zen base URL. Normally discovered from the catalog's `opencode.api` field --
# only set this to pin a different gateway (e.g. a local mock).
# OPENCODE_ZEN_URL=

# Anonymous credential understood by the gateway. Do not change unless OpenCode
# changes it upstream (packages/core/src/plugin/provider/opencode.ts:178).
# OPENCODE_PUBLIC_KEY=public

# "served"  (default) only models the gateway currently lists at /zen/v1/models
# "catalog"           every free model in the catalog, served or not
# OPENCODE_MODEL_FILTER=served

# Timeouts and caching.
# OPENCODE_CATALOG_TTL_MS=300000
# OPENCODE_CATALOG_TIMEOUT_MS=10000

# TOTAL budget for one client request, shared across every retry attempt.
# OPENCODE_REQUEST_TIMEOUT_MS=120000

# Retries after the first attempt, for transient upstream failures only
# (408/500/502/503/504 and network errors). 429 and other 4xx are NEVER retried.
# Set to 0 to disable retrying entirely.
# OPENCODE_MAX_RETRIES=2
# OPENCODE_RETRY_BASE_MS=250

# Identify yourself honestly; do not impersonate the official OpenCode client.
# OPENCODE_USER_AGENT=opencode-free-api/0.1.0
